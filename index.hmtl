<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Únete a Nuestro Nuevo Estudio Webcam | Convocatoria Oficial</title>
    <style>
        :root {
            --bg-dark: #090612;
            --card-glass: rgba(18, 12, 34, 0.86);
            --input-bg: rgba(34, 24, 58, 0.9);
            --neon-pink: #ff007f;
            --neon-purple: #9d00ff;
            --neon-cyan: #00f0ff;
            --text-main: #ffffff;
            --text-soft: #d4cce6;
            --border-glow: rgba(255, 0, 127, 0.4);
            --whatsapp: #25D366;
            --whatsapp-hover: #1ebe5d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            background-image: 
                linear-gradient(135deg, rgba(9, 6, 18, 0.88) 0%, rgba(36, 9, 53, 0.85) 50%, rgba(9, 6, 18, 0.94) 100%),
                url('https://images.unsplash.com/photo-1598550476439-6847785fcea6?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--text-main);
            line-height: 1.6;
            padding: 25px 15px 50px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .wrapper {
            width: 100%;
            max-width: 760px;
        }

        /* HERO / PRESENTACIÓN LLAMATIVA */
        .hero-card {
            background: var(--card-glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 35px 28px;
            text-align: center;
            margin-bottom: 25px;
            box-shadow: 0 0 35px rgba(255, 0, 127, 0.25), 0 15px 35px rgba(0, 0, 0, 0.7);
            position: relative;
            overflow: hidden;
        }

        .hero-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink), var(--neon-purple));
        }

        .badge-new {
            display: inline-block;
            background: linear-gradient(90deg, var(--neon-pink), var(--neon-purple));
            color: #fff;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            padding: 6px 16px;
            border-radius: 50px;
            margin-bottom: 16px;
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.6);
        }

        .hero-card h1 {
            font-size: 2.1rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 14px;
            background: linear-gradient(90deg, #ffffff, #ff7eb3, var(--neon-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-lead {
            font-size: 1.02rem;
            color: var(--text-soft);
            max-width: 640px;
            margin: 0 auto 24px auto;
        }

        .hero-lead strong {
            color: #ffffff;
        }

        /* CUADRÍCULA DE BENEFICIOS Y COMPROMISO */
        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            text-align: left;
            margin-top: 20px;
        }

        @media (max-width: 600px) {
            .benefits-grid {
                grid-template-columns: 1fr;
            }
            .hero-card h1 {
                font-size: 1.65rem;
            }
        }

        .benefit-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(157, 0, 255, 0.35);
            border-radius: 14px;
            padding: 16px;
            transition: transform 0.25s, border-color 0.25s;
        }

        .benefit-item:hover {
            transform: translateY(-3px);
            border-color: var(--neon-cyan);
        }

        .benefit-icon {
            font-size: 1.5rem;
            margin-bottom: 6px;
            display: block;
        }

        .benefit-item h3 {
            font-size: 0.98rem;
            color: var(--neon-cyan);
            margin-bottom: 5px;
        }

        .benefit-item p {
            font-size: 0.86rem;
            color: var(--text-soft);
            line-height: 1.45;
        }

        .commitment-banner {
            margin-top: 22px;
            padding: 14px 18px;
            border-radius: 12px;
            background: linear-gradient(90deg, rgba(255, 0, 127, 0.16), rgba(0, 240, 255, 0.14));
            border: 1px solid rgba(0, 240, 255, 0.35);
            font-size: 0.9rem;
            color: #ffffff;
        }

        /* CONTENEDOR DEL FORMULARIO */
        .form-container {
            background: var(--card-glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 32px 26px;
            border: 1px solid rgba(157, 0, 255, 0.45);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.75);
        }

        .form-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .form-header h2 {
            font-size: 1.55rem;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .form-header p {
            font-size: 0.9rem;
            color: var(--text-soft);
        }

        .section-title {
            font-size: 1rem;
            color: var(--neon-pink);
            margin: 26px 0 14px 0;
            padding-bottom: 6px;
            border-bottom: 1px solid rgba(255, 0, 127, 0.25);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        @media (max-width: 550px) {
            .row {
                grid-template-columns: 1fr;
            }
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.88rem;
            color: #f0eaff;
            font-weight: 500;
        }

        label span.req {
            color: var(--neon-pink);
            font-weight: bold;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"],
        input[type="tel"],
        select,
        textarea {
            width: 100%;
            padding: 12px 14px;
            background-color: var(--input-bg);
            border: 1px solid rgba(157, 0, 255, 0.4);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 0.94rem;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: var(--neon-cyan);
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
        }

        textarea {
            resize: vertical;
            min-height: 85px;
        }

        /* Carga de archivos */
        .file-upload-box {
            border: 2px dashed rgba(255, 0, 127, 0.55);
            background-color: var(--input-bg);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .file-upload-box:hover {
            border-color: var(--neon-cyan);
            background-color: rgba(45, 32, 75, 0.95);
        }

        .file-upload-box input[type="file"] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
        }

        .file-label-text {
            font-size: 0.88rem;
            color: var(--text-soft);
        }

        .file-label-text strong {
            color: var(--neon-cyan);
        }

        .preview-img {
            max-width: 100%;
            max-height: 150px;
            margin-top: 10px;
            border-radius: 8px;
            display: none;
            object-fit: cover;
            border: 1px solid var(--neon-cyan);
        }

        .hidden {
            display: none;
        }

        .checkbox-group {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-top: 20px;
            font-size: 0.85rem;
            color: var(--text-soft);
        }

        .checkbox-group input[type="checkbox"] {
            margin-top: 4px;
            accent-color: var(--neon-pink);
            width: 17px;
            height: 17px;
        }

        .note-box {
            background: rgba(37, 211, 102, 0.12);
            border-left: 4px solid var(--whatsapp);
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 0.86rem;
            color: #d8ffea;
            margin-top: 20px;
        }

        .btn-submit {
            width: 100%;
            padding: 16px;
            margin-top: 22px;
            background: linear-gradient(90deg, #1ebe5d, #25D366);
            color: #06180d;
            font-size: 1.08rem;
            font-weight: 800;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 0 20px rgba(37, 211, 102, 0.45);
            transition: transform 0.15s, box-shadow 0.3s;
        }

        .btn-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 0 28px rgba(37, 211, 102, 0.75);
        }

        .btn-submit:active:not(:disabled) {
            transform: scale(0.98);
        }

        .btn-submit:disabled {
            opacity: 0.7;
            cursor: wait;
        }

        .status-msg {
            margin-top: 14px;
            text-align: center;
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--neon-cyan);
            display: none;
        }
    </style>
</head>
<body>

<div class="wrapper">

    <!-- SECCIÓN DE PRESENTACIÓN Y CONVENCIÓN -->
    <section class="hero-card">
        <span class="badge-new">✨ Gran Apertura en la Ciudad • Cupos Limitados ✨</span>
        <h1>Tu Independencia Financiera Empieza en un Estudio Hecho a Otro Nivel</h1>
        <p class="hero-lead">
            Somos un <strong>estudio webcam nuevo en la ciudad</strong>, nacido con una visión diferente: construir una relación basada en el <strong>respeto, la responsabilidad y el cumplimiento real</strong>. Al ingresar en nuestra etapa de apertura, haces parte de nuestro equipo fundador con atención 100% personalizada y sin roscas ni favoritismos.
        </p>

        <div class="benefits-grid">
            <div class="benefit-item">
                <span class="benefit-icon">💎</span>
                <h3>Seriedad y Pagos Puntuales</h3>
                <p>Nuestro compromiso número uno es tu tranquilidad. Cuentas transparentes, liquidaciones exactas y cero retrasos en tus pagos.</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">🎥</span>
                <h3>Habitaciones Nuevas y Equipadas</h3>
                <p>Sets privados recién diseñados con estética moderna, iluminación LED profesional, cámaras de alta definición y fibra óptica de máxima velocidad.</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">🚀</span>
                <h3>Acompañamiento Paso a Paso</h3>
                <p>¿Es tu primera vez? Te capacitamos desde cero en posicionamiento, manejo de plataformas, estilo y estrategias para maximizar tus ingresos.</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">🔒</span>
                <h3>Privacidad y Ambiente Sano</h3>
                <p>Bloqueo geográfico para Colombia si lo deseas, absoluta reserva de tu identidad y un entorno seguro, limpio y respetuoso.</p>
            </div>
        </div>

        <div class="commitment-banner">
            🤝 <strong>Nuestro Pacto Contigo:</strong> Si tú pones la disciplina y las ganas de salir adelante, nosotros ponemos las herramientas, el respaldo técnico y la responsabilidad para que alcances tus metas económicas.
        </div>
    </section>

    <!-- FORMULARIO DE POSTULACIÓN -->
    <section class="form-container">
        <div class="form-header">
            <h2>📋 Formulario de Postulación</h2>
            <p>Diligencia tu hoja de vida básica para agendar tu entrevista confidencial.</p>
        </div>

        <form id="postulacionForm" enctype="multipart/form-data">
            <!-- SECCIÓN 1: DATOS PERSONALES -->
            <div class="section-title">1. Información Personal (Hoja de Vida)</div>
            
            <div class="form-group">
                <label for="nombre">Nombre Completo <span class="req">*</span></label>
                <input type="text" id="nombre" name="Nombre_Completo" placeholder="Ej: Valentina Morales Pérez" required>
            </div>

            <div class="row">
                <div class="form-group">
                    <label for="documento">Número de Cédula (C.C.) <span class="req">*</span></label>
                    <input type="number" id="documento" name="Numero_Cedula" placeholder="Ej: 1061789456" required>
                </div>
                <div class="form-group">
                    <label for="fechaNacimiento">Fecha de Nacimiento <span class="req">*</span></label>
                    <input type="date" id="fechaNacimiento" name="Fecha_Nacimiento" required>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <label for="telefono">Teléfono / WhatsApp Personal <span class="req">*</span></label>
                    <input type="tel" id="telefono" name="Telefono_WhatsApp" placeholder="Ej: 312 456 7890" required>
                </div>
                <div class="form-group">
                    <label for="ciudad">Ciudad y Barrio <span class="req">*</span></label>
                    <input type="text" id="ciudad" name="Ciudad_y_Barrio" placeholder="Ej: Popayán - Barrio Bolívar" required>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <label for="genero">Categoría / Género <span class="req">*</span></label>
                    <select id="genero" name="Categoria_Genero" required>
                        <option value="">Selecciona una opción...</option>
                        <option value="Mujer">Mujer</option>
                        <option value="Hombre">Hombre</option>
                        <option value="Trans">Trans</option>
                        <option value="Pareja">Pareja</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="instagram">Instagram o Red Social (Opcional)</label>
                    <input type="text" id="instagram" name="Instagram_Red_Social" placeholder="@usuario">
                </div>
            </div>

            <!-- SECCIÓN 2: DOCUMENTACIÓN Y FOTOS -->
            <div class="section-title">2. Verificación de Identidad y Fotos</div>

            <div class="row">
                <div class="form-group">
                    <label>Foto del Documento (Frente) <span class="req">*</span></label>
                    <div class="file-upload-box">
                        <input type="file" id="fotoDocumento" accept="image/*" required onchange="previewImage(this, 'previewDoc')">
                        <div class="file-label-text">
                            🪪 <strong>Toca aquí para subir foto</strong><br>
                            <span>Cédula legible (Solo mayores de 18 años)</span>
                        </div>
                        <img id="previewDoc" class="preview-img" alt="Vista previa documento">
                    </div>
                </div>

                <div class="form-group">
                    <label>Foto Personal Reciente <span class="req">*</span></label>
                    <div class="file-upload-box">
                        <input type="file" id="fotoPersona" accept="image/*" required onchange="previewImage(this, 'previewPer')">
                        <div class="file-label-text">
                            📸 <strong>Toca aquí para subir foto</strong><br>
                            <span>Rostro o cuerpo entero buena luz</span>
                        </div>
                        <img id="previewPer" class="preview-img" alt="Vista previa persona">
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: EXPERIENCIA Y DISPONIBILIDAD -->
            <div class="section-title">3. Experiencia y Disponibilidad</div>

            <div class="row">
                <div class="form-group">
                    <label for="experiencia">¿Has trabajado antes como modelo webcam? <span class="req">*</span></label>
                    <select id="experiencia" name="Experiencia_Previa" required onchange="toggleExperiencia()">
                        <option value="">Selecciona...</option>
                        <option value="No, sería mi primera vez">No, sería mi primera vez</option>
                        <option value="Sí, tengo experiencia">Sí, tengo experiencia</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="ingles">Nivel de Inglés <span class="req">*</span></label>
                    <select id="ingles" name="Nivel_Ingles" required>
                        <option value="Básico (Uso traductor)">Básico (Uso traductor)</option>
                        <option value="Intermedio">Intermedio</option>
                        <option value="Avanzado / Fluido">Avanzado / Fluido</option>
                    </select>
                </div>
            </div>

            <div id="detalleExperiencia" class="hidden">
                <div class="row">
                    <div class="form-group">
                        <label for="tiempoExp">¿Cuánto tiempo de experiencia tienes?</label>
                        <input type="text" id="tiempoExp" name="Tiempo_Experiencia" placeholder="Ej: 8 meses / 2 años">
                    </div>
                    <div class="form-group">
                        <label for="plataformas">¿En qué páginas has transmitido?</label>
                        <input type="text" id="plataformas" name="Plataformas_Anteriores" placeholder="Ej: Chaturbate, Stripchat, Cam4...">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <label for="turno">Disponibilidad de Turno <span class="req">*</span></label>
                    <select id="turno" name="Turno_Deseado" required>
                        <option value="">Selecciona un horario...</option>
                        <option value="Mañana (6:00 AM - 2:00 PM)">Mañana (6:00 AM - 2:00 PM)</option>
                        <option value="Tarde (2:00 PM - 10:00 PM)">Tarde (2:00 PM - 10:00 PM)</option>
                        <option value="Noche (10:00 PM - 6:00 AM)">Noche (10:00 PM - 6:00 AM)</option>
                        <option value="Tiempo completo / Flexible">Tiempo completo / Flexible</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="modalidad">Modalidad Preferida <span class="req">*</span></label>
                    <select id="modalidad" name="Modalidad" required>
                        <option value="Presencial en el Estudio">Presencial en el Estudio</option>
                        <option value="Satélite (Desde casa)">Satélite (Desde casa)</option>
                    </select>
                </div>
            </div>

            <!-- SECCIÓN 4: ASPIRACIONES Y COMPROMISO -->
            <div class="section-title">4. Tus Aspiraciones y Metas</div>

            <div class="form-group">
                <label for="aspiracionSalarial">¿Cuál es tu meta de ingresos mensuales? <span class="req">*</span></label>
                <input type="text" id="aspiracionSalarial" name="Meta_Ingresos_Mensuales" placeholder="Ej: $2.500.000 COP o $800 USD" required>
            </div>

            <div class="form-group">
                <label for="aspiraciones">¿Qué metas quieres lograr con este trabajo y qué buscas en un estudio? <span class="req">*</span></label>
                <textarea id="aspiraciones" name="Aspiraciones_y_Metas" placeholder="Cuéntanos qué te motiva (pagar estudios, independencia económica, ayudar a tu familia, estabilidad, buen trato)..." required></textarea>
            </div>

            <div class="form-group">
                <label for="referido">¿Cómo te enteraste de nosotros?</label>
                <select id="referido" name="Como_Nos_Conocio">
                    <option value="Redes Sociales (Instagram / TikTok / Facebook)">Redes Sociales (Instagram / TikTok / Facebook)</option>
                    <option value="Recomendación de una amiga/modelo">Recomendación de una amiga/modelo</option>
                    <option value="Anuncio web / WhatsApp">Anuncio web / WhatsApp</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" id="mayorEdad" required>
                <label for="mayorEdad">Confirmo que soy <strong>mayor de 18 años</strong> y autorizo el uso estrictamente confidencial de mis datos para este proceso de selección.</label>
            </div>

            <div class="note-box">
                📩 <strong>Envío automático completo:</strong> Tus datos y las <strong>2 fotos adjuntas</strong> se enviarán directamente al correo de selección del estudio y enseguida se abrirá WhatsApp para confirmar tu entrevista.
            </div>

            <button type="submit" id="btnSubmit" class="btn-submit">
                🚀 Enviar Postulación y Fotos Ahora
            </button>
            <div id="statusMsg" class="status-msg">⏳ Optimizando fotos y enviando postulación, por favor espera...</div>
        </form>
    </section>

</div>

<script>
    function toggleExperiencia() {
        const exp = document.getElementById('experiencia').value;
        const detalle = document.getElementById('detalleExperiencia');
        if (exp === 'Sí, tengo experiencia') {
            detalle.classList.remove('hidden');
        } else {
            detalle.classList.add('hidden');
        }
    }

    function previewImage(input, previewId) {
        const preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'inline-block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function calcularEdad(fechaNac) {
        const hoy = new Date();
        const cumple = new Date(fechaNac);
        let edad = hoy.getFullYear() - cumple.getFullYear();
        const mes = hoy.getMonth() - cumple.getMonth();
        if (mes < 0 || (mes === 0 && hoy.getDate() < cumple.getDate())) {
            edad--;
        }
        return edad;
    }

    // Compresor automático de imágenes (reduce fotos pesadas a ~250KB manteniendo nitidez HD)
    function comprimirImagen(file, nuevoNombre, maxAncho = 1280, calidad = 0.82) {
        return new Promise((resolve) => {
            if (!file) {
                resolve(null);
                return;
            }
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    let width = img.width;
                    let height = img.height;

                    if (width > maxAncho || height > maxAncho) {
                        if (width > height) {
                            height = Math.round((height * maxAncho) / width);
                            width = maxAncho;
                        } else {
                            width = Math.round((width * maxAncho) / height);
                            height = maxAncho;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob(
                        (blob) => {
                            if (blob) {
                                resolve(new File([blob], nuevoNombre, { type: 'image/jpeg' }));
                            } else {
                                resolve(file);
                            }
                        },
                        'image/jpeg',
                        calidad
                    );
                };
                img.onerror = () => resolve(file);
                img.src = event.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    document.getElementById('postulacionForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const fechaNac = document.getElementById('fechaNacimiento').value;
        const edad = calcularEdad(fechaNac);

        if (edad < 18) {
            alert('❌ Lo sentimos, debes ser mayor de 18 años para postularte.');
            return;
        }

        const btnSubmit = document.getElementById('btnSubmit');
        const statusMsg = document.getElementById('statusMsg');

        btnSubmit.disabled = true;
        btnSubmit.textContent = '⏳ Optimizando y enviando fotos...';
        statusMsg.style.display = 'block';

        const nombre = document.getElementById('nombre').value.trim();
        const documento = document.getElementById('documento').value.trim();
        const telefono = document.getElementById('telefono').value.trim();
        const ciudad = document.getElementById('ciudad').value.trim();
        const genero = document.getElementById('genero').value;
        const instagram = document.getElementById('instagram').value.trim() || 'No registra';
        
        const experiencia = document.getElementById('experiencia').value;
        const tiempoExp = document.getElementById('tiempoExp').value.trim() || 'N/A';
        const plataformas = document.getElementById('plataformas').value.trim() || 'N/A';
        const ingles = document.getElementById('ingles').value;
        
        const turno = document.getElementById('turno').value;
        const modalidad = document.getElementById('modalidad').value;
        const aspiracionSalarial = document.getElementById('aspiracionSalarial').value.trim();
        const aspiraciones = document.getElementById('aspiraciones').value.trim();
        const referido = document.getElementById('referido').value;

        // Comprimir ambas fotos antes de adjuntarlas
        const fileDocRaw = document.getElementById('fotoDocumento').files[0];
        const filePerRaw = document.getElementById('fotoPersona').files[0];

        const nombreLimpio = nombre.replace(/[^a-zA-Z0-9]/g, '_');
        const [fotoDocComprimida, fotoPerComprimida] = await Promise.all([
            comprimirImagen(fileDocRaw, `Cedula_${nombreLimpio}.jpg`),
            comprimirImagen(filePerRaw, `Foto_${nombreLimpio}.jpg`)
        ]);

        // 1. Preparar envío de datos + fotos comprimidas a veroar533@gmail.com
        const formData = new FormData(this);
        if (fotoDocComprimida) formData.append('Foto_Documento_Identidad', fotoDocComprimida);
        if (fotoPerComprimida) formData.append('Foto_Personal', fotoPerComprimida);
        
        formData.append('Edad_Calculada', edad + ' años');
        formData.append('_subject', `Nueva Postulación Webcam: ${nombre} (${edad} años)`);
        formData.append('_template', 'table');
        formData.append('_captcha', 'false');

        try {
            await fetch('https://formsubmit.co/veroar533@gmail.com', {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            });
            statusMsg.textContent = '✅ ¡Fotos enviadas al correo! Abriendo WhatsApp...';
        } catch (error) {
            console.error('Error enviando correo:', error);
            statusMsg.textContent = '⚠️ Abriendo WhatsApp para completar tu postulación...';
        }

        // 2. Preparar mensaje de resumen para WhatsApp 3026327995
        let textoExperiencia = `*Experiencia previa:* ${experiencia}`;
        if (experiencia === 'Sí, tengo experiencia') {
            textoExperiencia += `\n• *Tiempo:* ${tiempoExp}\n• *Plataformas:* ${plataformas}`;
        }

        const mensaje = 
`🔥 *NUEVA POSTULACIÓN - NUEVO ESTUDIO WEBCAM* 🔥

👤 *DATOS PERSONALES*
• *Nombre:* ${nombre}
• *Cédula:* ${documento}
• *Edad:* ${edad} años (${fechaNac})
• *Categoría:* ${genero}
• *WhatsApp:* ${telefono}
• *Ciudad/Barrio:* ${ciudad}
• *Instagram:* ${instagram}

💼 *PERFIL Y DISPONIBILIDAD*
• ${textoExperiencia}
• *Nivel de Inglés:* ${ingles}
• *Turno deseado:* ${turno}
• *Modalidad:* ${modalidad}

🎯 *ASPIRACIONES Y METAS*
• *Meta salarial:* ${aspiracionSalarial}
• *Motivación:* ${aspiraciones}
• *Nos conoció por:* ${referido}

📧 _Mis fotos (documento y foto personal) ya fueron enviadas al correo del estudio._`;

        const numeroDestino = "573026327995";
        const urlWhatsApp = `https://wa.me/${numeroDestino}?text=${encodeURIComponent(mensaje)}`;

        btnSubmit.disabled = false;
        btnSubmit.textContent = '🚀 Enviar Postulación y Fotos Ahora';

        // Redirigir a WhatsApp
        window.location.href = urlWhatsApp;
    });
</script>

</body>
</html>
